# Скопируйте этот файл в .env и заполните реальными данными.
# .env не должен попадать в git (см. .gitignore) — никогда не коммитьте реальные ключи.

# API-ключ BotHub (получить в личном кабинете: bothub.chat → меню → "Для разработчиков")
BOTHUB_API_KEY=ваш_ключ_тут

# Базовый адрес API BotHub (OpenAI-совместимый) — обычно менять не нужно
BOTHUB_BASE_URL=https://bothub.chat/api/v2/openai/v1

# Модель для генерации вопросов. Для качественного русского языка —
# claude-sonnet-5 или свежий GPT (уточните актуальные названия моделей
# в личном кабинете BotHub).
BOTHUB_MODEL=claude-sonnet-5

# Максимальное число вопросов за один запрос (защита от слишком дорогих вызовов)
MAX_QUESTIONS_PER_REQUEST=30

# Защита от случайного большого расхода в режиме «Тест для курса»: файл длиннее
# этого числа символов ИИ не обрабатывает (файлы Aiken читаются без ИИ и не ограничены).
COURSE_MAX_CHARS=60000

# Лимит расхода на ОДИН файл, в CAPS. Как только файл «съел» столько, запросы к ИИ
# прекращаются и приложение пишет «Превышен лимит токенов на один файл». Проверка идёт
# между запросами, поэтому итог может превысить лимит на стоимость одного запроса.
# 0 — без лимита.
COURSE_MAX_CAPS=20000

# Тариф для оценки расхода в интерфейсе (CAPS за токен). Значения для claude-sonnet-5;
# при смене модели сверьте с прайсом BotHub. Это только прикидка, настоящее списание
# смотрите в личном кабинете.
BOTHUB_RUB_PER_CAP=0.0001

# --- Moodle (ЭИОС), автозагрузка тестов в курс ---
# Адрес сайта без слова /webservice. Токен: Администрирование → Сервер → Веб-сервисы →
# Управление токенами. Токен — как пароль, в Git его не добавляем.
MOODLE_URL=https://m45.umu.vstu.ru
MOODLE_TOKEN=
# Папка в банке вопросов курса, куда кладётся тест.
MOODLE_CATEGORY=Промежуточная аттестация 2026

# Реестр тестов (элемент «База данных»): номер курса, где он лежит, и его название.
MOODLE_REGISTRY_COURSE=17
MOODLE_REGISTRY_NAME=Реестр тестов промежуточной аттестации
