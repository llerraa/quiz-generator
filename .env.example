# Скопируйте этот файл в .env и заполните реальными данными.
# .env не должен попадать в git (см. .gitignore) — никогда не коммитьте реальные ключи.

# API-ключ BotHub (получить в личном кабинете: bothub.chat → меню → "Для разработчиков")
BOTHUB_API_KEY=ваш_ключ_тут

# Базовый адрес API BotHub (OpenAI-совместимый) — обычно менять не нужно
BOTHUB_BASE_URL=https://bothub.chat/api/v2/openai/v1

# Модель для генерации вопросов. Для качественного русского языка —
# claude-sonnet-5 или свежий GPT (уточните актуальные названия моделей
# в личном кабинете BotHub).
BOTHUB_MODEL=claude-sonnet-5

# Максимальное число вопросов за один запрос (защита от слишком дорогих вызовов)
MAX_QUESTIONS_PER_REQUEST=30

