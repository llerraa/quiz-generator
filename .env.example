# Скопируйте этот файл в .env и заполните реальными данными.
# .env не должен попадать в git (см. .gitignore) — никогда не коммитьте реальные ключи.

# Авторизационный ключ GigaChat API (Client ID + Client Secret в base64,
# выдаётся в личном кабинете developers.sber.ru после создания проекта GigaChat API)
GIGACHAT_CREDENTIALS=ваш_ключ_авторизации_тут

# Область доступа: для физлица (Freemium) — GIGACHAT_API_PERS
# при переходе на организационный тариф ИМЭС поменяется на GIGACHAT_API_B2B / _CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat для генерации вопросов.
# Реальный список моделей для вашего ключа можно получить через giga.get_models() —
# у нас это были: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra.
# GigaChat-2 — самая дешёвая (и самый большой бесплатный лимит), для прототипа хватит.
GIGACHAT_MODEL=GigaChat-2

# Максимальное число вопросов за один запрос (защита от слишком дорогих вызовов)
MAX_QUESTIONS_PER_REQUEST=30
